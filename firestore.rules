rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Trade License Applications and Issued Certificates
    match /applications/{applicationId} {
      // Anyone can read to verify QR code and track application status
      allow read: if true;
      // Citizens can submit new applications
      allow create: if request.resource.data.businessName is string 
                    && request.resource.data.mobile is string;
      // Citizens can submit TRX ID and Admin can approve, reject, issue license
      allow update: if request.resource.data.businessName is string;
      allow delete: if false;
    }

    // Municipality Portal Settings and Payment Info
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
